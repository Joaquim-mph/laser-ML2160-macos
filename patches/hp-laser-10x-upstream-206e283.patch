     }
diff --git a/src/compress.cpp b/src/compress.cpp
index 5572e64c..7d5d2a23 100644
--- a/src/compress.cpp
+++ b/src/compress.cpp
@@ -33,6 +33,44 @@
 #include "algo0x13.h"
 #include "algo0x15.h"
 
+/*
+ * Look up bandwidths in bytes generated by Samsung ULD for 2020 series
+ * Samsung M2026 does not work unless it receives _exactly_ the right bandwidths
+ * There does not seem to be a general formula for all paper sizes, hence simple lookup
+ */
+unsigned long _get2020BandWidthInB(unsigned char papertype, unsigned long xresolution) {
+    struct Bw {
+        unsigned char papertype;
+        unsigned long width[2];  //standard and high resolution
+    };
+
+    const Bw bw[] = {
+        {0,640,1248},  //letter
+        {1,640,1248},  //legal
+        {2,608,1216},	//a4
+        {3,544,1056}, 	//executive
+        {6,288,576},	//Env10
+        {7,288,544},	//monarch envelope
+        {8,480,928},	//c5 envelope
+        {9,320,608},	//DL envelope
+        {11,544,1056},	//b5
+        {12,512,992},	//b5 iso envelope
+        {14,288,576},	//postcard 4x6
+        {16,416,832},	//a5
+        {24,640,1248},	//folio
+        {28,640,1248}	//Oficio
+    };
+
+    for (unsigned int i=0; i<sizeof(bw)/sizeof(bw[0]); i++) {
+        if (bw[i].papertype == papertype) {
+            if (xresolution == 600) return bw[i].width[0];
+            if (xresolution == 1200) return bw[i].width[1];
+            break;
+        }
+    }
+    return 0;
+}
+
 static bool _isEmptyBand(unsigned char* band, unsigned long size)
 {
     unsigned long max, mod;
@@ -53,6 +91,7 @@ static bool _isEmptyBand(unsigned char* band, unsigned long size)
 static bool _compressBandedPage(const Request& request, Page* page)
 {
     unsigned long index=0, pageHeight, pageWidth, lineWidthInB, bandHeight;
+    unsigned long bandWidth, bandWidthInB;
     unsigned long bandSize, hardMarginX, hardMarginXInB, hardMarginY;
     unsigned char *planes[4], *band;
     unsigned long bandNumber=0;
@@ -72,7 +111,16 @@ static bool _compressBandedPage(const Request& request, Page* page)
     bandHeight = request.printer()->bandHeight();
     if (page->xResolution() == 300 && page->yResolution() == 300)
         bandHeight /= 2;
-    bandSize = lineWidthInB * bandHeight;
+
+    //Patch for Samsung M2026
+    if (request.printer()->specialBandWidth()) {
+        bandWidthInB = _get2020BandWidthInB(request.printer()->paperType(), page->xResolution());
+        if (!bandWidthInB) bandWidthInB = lineWidthInB;
+    }
+    else bandWidthInB = lineWidthInB;  //original assumption before M2026 patch
+    bandWidth = bandWidthInB * 8;
+    bandSize = bandWidthInB * bandHeight;
+
     index = hardMarginY * lineWidthInB;
     band = new unsigned char[bandSize];
     for (unsigned int i=0; i < colors; i++)
@@ -121,20 +169,18 @@ static bool _compressBandedPage(const Request& request, Page* page)
             // Copy the data into the band depending on the algorithm options
             if (algo->reverseLineColumn()) {
                 for (unsigned int y=0; y < localHeight; y++) {
-                    for (unsigned int x=0; x < lineWidthInB - hardMarginXInB; x++) {
-                        band[x * bandHeight + y] = planes[i][index + x +
-                            hardMarginXInB + y * lineWidthInB];
+                    for (unsigned int x=0; (x < lineWidthInB - hardMarginXInB) && (x < bandWidthInB); x++) {
+                        band[x * bandHeight + y] = planes[i][index + x + hardMarginXInB + y * lineWidthInB]; // ERR?
                     }
-                    for (unsigned int x=lineWidthInB - hardMarginXInB; x < lineWidthInB; x++)
+                    for (unsigned int x=lineWidthInB - hardMarginXInB; x < bandWidthInB; x++)
                         band[x * bandHeight + y] = 0;
                 }
             } else {
                 for (unsigned int y=0; y < localHeight; y++) {
-                    for (unsigned int x=0; x < lineWidthInB - hardMarginXInB; x++) {
-                        band[x + y * lineWidthInB] = planes[i][index + x +
-                            hardMarginXInB + y * lineWidthInB];
+                    for (unsigned int x=0; (x < lineWidthInB - hardMarginXInB) && (x < bandWidthInB); x++) {
+                        band[x + y * bandWidthInB] = planes[i][index + x + hardMarginXInB + y * lineWidthInB];
                     }
-                    for (unsigned int x=lineWidthInB - hardMarginXInB; x < lineWidthInB; x++)
+                    for (unsigned int x=lineWidthInB - hardMarginXInB; x < bandWidthInB; x++)
                         band[x + y * lineWidthInB]  = 0;
                 }
             }
@@ -151,7 +197,7 @@ static bool _compressBandedPage(const Request& request, Page* page)
                     band[j] = ~band[j];
 
             // Call the compression method
-            plane = algo->compress(request, band, pageWidth, bandHeight);
+            plane = algo->compress(request, band, bandWidth, bandHeight);
             /*
              * If algorithm 0xd did not create a plane, it means that the 
              * complementary algorithm 0xE need to be used
@@ -163,13 +209,13 @@ static bool _compressBandedPage(const Request& request, Page* page)
                 for (unsigned int j = 0; j < bandSize; j++)
                     band[j] = ~band[j];
                 /* Do the encoding with algo0xe. */
-                plane = algo->compress(request, band, pageWidth, bandHeight);
+                plane = algo->compress(request, band, bandWidth, bandHeight);
             }
 
             if (plane) {
                 plane->setColorNr(i + 1);
                 if (!current)
-                    current = new Band(bandNumber, pageWidth, bandHeight);
+                    current = new Band(bandNumber, bandWidth, bandHeight);
                 current->registerPlane(plane);
             }
 
@@ -178,7 +224,7 @@ static bool _compressBandedPage(const Request& request, Page* page)
         if (current)
             page->registerBand(current);
         bandNumber++;
-        index += bandSize;
+        index += lineWidthInB * bandHeight;
         pageHeight = theEnd ? 0 : pageHeight - bandHeight;
     }
     page->flushPlanes();
