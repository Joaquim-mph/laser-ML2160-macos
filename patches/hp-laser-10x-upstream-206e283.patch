 ppd/Makefile       | 26 ++++++++++++++---
 ppd/hp.drv.in      | 50 ++++++++++++++++++++++++++++++++
 ppd/samsung.drv.in |  9 +++++-
 src/compress.cpp   | 72 +++++++++++++++++++++++++++++++++++++---------
 src/printer.cpp    |  1 +
 6 files changed, 146 insertions(+), 18 deletions(-)
 create mode 100644 ppd/hp.drv.in

